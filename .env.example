# =============================================================================
# Copy to ".env" at the repo root and/or "apps/web/.env.local" and fill in values.
# Never commit real secrets.
# =============================================================================

# PostgreSQL (Prisma — http-backend, ws-backend)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# JWT signing — use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=

# WebSocket server (ws-backend)
WS_BACKEND_PORT=8082

# Must match WS_BACKEND_PORT when the browser connects in dev
NEXT_PUBLIC_WS_PORT=8082

# Production WebSocket URL (set at build time), e.g. wss://your-ws.up.railway.app
NEXT_PUBLIC_WS_URL=

# AI diagram (apps/web api/diagram) — set one; Mistral takes precedence if both set
OPENAI_API_KEY=
MISTRAL_API_KEY=

# Clerk auth (https://dashboard.clerk.com → API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
